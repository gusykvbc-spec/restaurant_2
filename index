  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: var(--bg); color: var(--text); line-height: 1.6; }
  
  .header { background: linear-gradient(135deg, #1e293b 0%, #334155 100%); color: white; padding: 48px 32px 40px; text-align: center; }
  .header h1 { font-size: 2rem; font-weight: 700; margin-bottom: 8px; }
  .header p { opacity: 0.8; font-size: 1rem; }
  .meta-pills { display: flex; justify-content: center; gap: 12px; margin-top: 20px; flex-wrap: wrap; }
  .pill { background: rgba(255,255,255,0.15); border-radius: 999px; padding: 4px 14px; font-size: 0.85rem; }
  
  .container { max-width: 1100px; margin: 0 auto; padding: 32px 20px; }
  
  .section-title { font-size: 1.25rem; font-weight: 700; margin-bottom: 20px; padding-bottom: 8px; border-bottom: 2px solid var(--border); color: var(--text); }
  
  /* Top pick hero */
  .hero { background: linear-gradient(135deg, #065f46 0%, #047857 100%); color: white; border-radius: 16px; padding: 32px; margin-bottom: 32px; }
  .hero-label { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.1em; opacity: 0.8; text-transform: uppercase; margin-bottom: 8px; }
  .hero h2 { font-size: 1.8rem; font-weight: 800; margin-bottom: 6px; }
  .hero-meta { opacity: 0.9; margin-bottom: 12px; font-size: 0.95rem; }
  .hero-score { font-size: 3rem; font-weight: 900; opacity: 0.15; position: absolute; right: 32px; top: 24px; }
  .hero { position: relative; }
  .hero-sig { background: rgba(255,255,255,0.15); border-radius: 8px; padding: 10px 14px; font-size: 0.9rem; margin-top: 12px; display: inline-block; }
  .hero-actions { margin-top: 20px; display: flex; gap: 12px; flex-wrap: wrap; }
  .btn { display: inline-block; padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.9rem; }
  .btn-white { background: white; color: #065f46; }
  .btn-outline { background: transparent; color: white; border: 2px solid rgba(255,255,255,0.5); }

  /* Cards grid */
  .cards-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 40px; }
  @media (max-width: 700px) { .cards-grid { grid-template-columns: 1fr; } }
  .card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 20px; }
  .top-pick-card { border-color: var(--gold); border-width: 2px; }
  .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
  .role-badge { font-size: 0.8rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; background: #fef3c7; color: #92400e; }
  .backup-card .role-badge { background: #f1f5f9; color: var(--muted); }
  .score-badge { font-size: 1.1rem; font-weight: 800; color: var(--green); }
  .card h3 { font-size: 1rem; font-weight: 700; margin-bottom: 6px; }
  .card-meta { font-size: 0.82rem; color: var(--muted); margin-bottom: 4px; }
  .signature { font-size: 0.85rem; color: var(--text); margin: 10px 0; font-style: italic; }
  .score-breakdown { margin: 12px 0; }
  .score-row { display: grid; grid-template-columns: 110px 1fr 50px; align-items: center; gap: 8px; margin-bottom: 5px; font-size: 0.78rem; }
  .bar-bg { background: #f1f5f9; border-radius: 4px; height: 6px; }
  .bar-fill { height: 6px; border-radius: 4px; transition: width 0.3s; }
  .score-num { text-align: right; color: var(--muted); font-size: 0.75rem; }
  .map-btn-lg { display: inline-block; margin-top: 12px; background: var(--blue); color: white; padding: 8px 16px; border-radius: 8px; text-decoration: none; font-size: 0.85rem; font-weight: 600; }

  /* Full ranking table */
  .table-wrap { overflow-x: auto; margin-bottom: 40px; }
  table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  th { background: #f1f5f9; padding: 10px 12px; text-align: left; font-weight: 600; color: var(--muted); border-bottom: 2px solid var(--border); }
  td { padding: 10px 12px; border-bottom: 1px solid var(--border); }
  tr:hover { background: #f8fafc; }
  .top-row td { background: #f0fdf4; }
  .top-row:hover td { background: #dcfce7; }
  .center { text-align: center; }
  .score-cell { font-weight: 800; color: var(--green); font-size: 1rem; }
  .rank-badge { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; font-weight: 700; font-size: 0.85rem; }
  .rank-gold { background: #fef3c7; color: #92400e; }
  .rank-silver { background: #f1f5f9; color: #475569; }
  .rank-bronze { background: #fef9ee; color: #78350f; }
  .rank-normal { background: #f8fafc; color: var(--muted); }
  .map-btn { display: inline-block; background: var(--blue); color: white; padding: 4px 10px; border-radius: 6px; text-decoration: none; font-size: 0.8rem; font-weight: 600; }

  /* Scoring weights legend */
