  @media (max-width: 600px) { .weights-grid { grid-template-columns: 1fr 1fr; } }
  .weight-card { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 14px; text-align: center; }
  .weight-val { font-size: 1.5rem; font-weight: 800; }
  .weight-label { font-size: 0.8rem; color: var(--muted); margin-top: 2px; }

  .footer { text-align: center; padding: 24px; color: var(--muted); font-size: 0.82rem; border-top: 1px solid var(--border); margin-top: 20px; }
</style>
</head>
